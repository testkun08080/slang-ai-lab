{
  "name": "slang-ai-lab",
  "version": "0.1.0",
  "description": "AI-powered Slang shader playground with in-browser compilation to WGSL/WebGPU",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/testkun08080/slang-ai-lab.git"
  },
  "bugs": {
    "url": "https://github.com/testkun08080/slang-ai-lab/issues"
  },
  "homepage": "https://github.com/testkun08080/slang-ai-lab#readme",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:ci": "npm run build && vitest run && playwright test",
    "lighthouse": "mkdir -p lighthouse-report && lighthouse http://127.0.0.1:3000 --preset=desktop --output=html --output=json --output-path=./lighthouse-report/report --chrome-flags='--headless=new --no-sandbox'",
    "lighthouse:ci": "start-server-and-test \"npm run start\" http://127.0.0.1:3000 \"npm run lighthouse || (test -f lighthouse-report/report.report.json && echo 'Lighthouse report generated despite non-zero exit code')\"",
    "qa:lighthouse": "npm run build && npm run lighthouse:ci"
  },
  "dependencies": {
